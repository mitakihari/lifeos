# Raw bank/card exports can contain account numbers: never commit them
finance/imports/raw/*
!finance/imports/raw/.gitkeep

# Obsidian plugin code: reinstalled on each machine by `lifeos plugins install`
# (settings in data.json and the enabled list still sync)
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css

# Obsidian per-device state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# Python / OS junk
__pycache__/
*.pyc
.DS_Store
Thumbs.db
~$*.xlsx
