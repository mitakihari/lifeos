filters:
  and:
    - 'type == "project"'
    - 'file.ext == "md"'

formulas:
  days_left: 'if(due, (date(due) - today()).days, "")'

properties:
  formula.days_left:
    displayName: "Days left"

views:
  - type: table
    name: "Active"
    filters:
      and:
        - 'status == "active"'
    order:
      - file.name
      - area
      - goal
      - due
      - formula.days_left
  - type: table
    name: "All"
    order:
      - file.name
      - status
      - area
      - due
    groupBy:
      property: status
      direction: ASC
