#!/bin/sh
# LifeOS pre-commit hook: blocks commits containing card/account numbers,
# SSNs, passwords, or raw bank exports. Installed via core.hooksPath=_system/hooks.
for py in python3 python py; do
  if command -v "$py" >/dev/null 2>&1; then
    exec "$py" "$(git rev-parse --show-toplevel)/_system/bin/lifeos.py" scan --staged
  fi
done
echo "LifeOS: Python not found, skipping secret scan." >&2
exit 0
